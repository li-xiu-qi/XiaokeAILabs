#!/bin/sh
# 提交前体积闸门。由 `bash scripts/install-hooks.sh` 安装，不要手工复制。
#
# 本钩子使用 git 和 Python 标准库，不依赖 pre-commit 包。

if command -v python >/dev/null 2>&1; then
    PY_BIN="python"
elif command -v python3 >/dev/null 2>&1; then
    PY_BIN="python3"
elif [ -f "C:/Users/ke/Documents/projects/obsidian_projects/pkm-hub-runtime/.venv/Scripts/python.exe" ]; then
    PY_BIN="C:/Users/ke/Documents/projects/obsidian_projects/pkm-hub-runtime/.venv/Scripts/python.exe"
elif [ -f "/c/Users/ke/Documents/projects/obsidian_projects/pkm-hub-runtime/.venv/Scripts/python.exe" ]; then
    PY_BIN="/c/Users/ke/Documents/projects/obsidian_projects/pkm-hub-runtime/.venv/Scripts/python.exe"
elif [ -f "/c/Users/ke/miniconda3/python.exe" ]; then
    PY_BIN="/c/Users/ke/miniconda3/python.exe"
else
    PY_BIN="python"
fi

"$PY_BIN" scripts/check_large_files.py || {
    echo ""
    echo "提交被拦截。确认这些文件确实必须入库时："
    echo "  - 数据集/模型 → 走 Release，仓里留下载脚本"
    echo "  - 图片 → 转 JPEG 或裁掉留白"
    echo "  - 确需例外 → 加进 scripts/check_large_files.py 的 ALLOWLIST 并写理由"
    echo "临时跳过（不推荐）：git commit --no-verify"
    exit 1
}

# notebook 输出检查：防止带执行结果的 ipynb 回流
"$PY_BIN" scripts/check_notebook_outputs.py || exit 1
