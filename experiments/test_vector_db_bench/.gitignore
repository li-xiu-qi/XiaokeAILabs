# 本实验的输入数据与全局 *.npz 规则冲突：20news_emb.npz 是实验输入，
# 不是构建生成的中间产物，重新生成要跑 7 分钟 embedding，值得入库。
!data/20news_emb.npz
# 20news_texts.npz 同理：20news 正文（与 train_emb 逐条对齐），文本存储 A/B 的输入。
# 源是 data/20news.pkl.gz（误命名的 20news-bydate tar.gz），可从它重新提取。
!data/20news_texts.npz

# 本实验的运行产物（不入库）
.venv/
__pycache__/
*.pyc
# Milvus 的 etcd / minio / 本地存储
config/volumes/
# SurrealDB rocksdb（每轮独立目录）
data/surreal/
# Qdrant 存储
data/qdrant/
# LanceDB 数据集与探针产物
data/lance/
data/lance_*/
# Chroma 运行存储与探针产物
data/chroma/
data/chroma_*/
# 中文分词探针的 LanceDB 数据集（可重新生成）
data/cn_*/
# SurrealDB 基准库（rocksdb 目录）
data/surreal_bench.db/
# sqlite-vec 库文件
data/sqlite_vec_*.db
# SurrealDB 旧版共享库
data/surreal.db/
results/
